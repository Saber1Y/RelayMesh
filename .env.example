# PortalDot V3 testnet (values confirmed by the PortalDot team, verified 2026-10-20)
PORTALDOT_V3_WS_URL=wss://test-node-v3.portaldot.dev
PORTALDOT_V3_EVM_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_V3_EVM_CHAIN_ID=420420777

# Optional: native (5...) address to inspect in spikes
SPIKE_SUBSTRATE_ADDRESS=

# Local Postgres from docker-compose.yml (dev-only credentials)
DATABASE_URL=postgres://relaymesh:relaymesh@127.0.0.1:54329/relaymesh
TEST_DATABASE_URL=postgres://relaymesh:relaymesh@127.0.0.1:54329/relaymesh_test

# Watcher (apps/worker). Anchoring to IntentRegistry is enabled only when both are set.
# RELAYER_PRIVATE_KEY is an EVM key holding tPOT on the V3 EVM side. Never commit a real key.
INTENT_REGISTRY_ADDRESS=
RELAYER_PRIVATE_KEY=
# Optional tuning (defaults shown)
# WATCHER_POLL_MS=6000
# WATCHER_SCAN_BACKFILL_BLOCKS=150
# WATCHER_MAX_BLOCKS_PER_PASS=100
# WATCHER_SIGNED_TX_LIFETIME_SECONDS=1800

# Contract deployment (contracts/scripts/deploy.ts). Never commit a real key.
DEPLOYER_PRIVATE_KEY=
