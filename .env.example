# PortalDot V3 testnet (values confirmed by the PortalDot team, verified 2026-10-20)
PORTALDOT_V3_WS_URL=wss://test-node-v3.portaldot.dev
PORTALDOT_V3_EVM_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_V3_EVM_CHAIN_ID=420420777
PORTALDOT_V3_EXPLORER_URL=https://scanner-testnet-v3.portaldot.dev

# Optional: native (5...) address to inspect in spikes
SPIKE_SUBSTRATE_ADDRESS=

# Local Postgres from docker-compose.yml (dev-only credentials)
DATABASE_URL=postgres://relaymesh:relaymesh@127.0.0.1:54329/relaymesh
TEST_DATABASE_URL=postgres://relaymesh:relaymesh@127.0.0.1:54329/relaymesh_test

# Watcher (apps/worker). Receipts are anchored in batches: in ReceiptBatchLog when its address is set
# (about 0.013 tPOT a write), otherwise in ReceiptBatchRegistry (about 3.9 tPOT a write). Anchoring is
# enabled only with a relayer key. RELAYER_PRIVATE_KEY is an EVM key holding tPOT on the V3 EVM side
# and must be the contract's recorder. Never commit a real key.
RECEIPT_BATCH_LOG_ADDRESS=
RECEIPT_BATCH_REGISTRY_ADDRESS=
RELAYER_PRIVATE_KEY=
# A batch is written when ANCHOR_BATCH_SIZE receipts wait, or the oldest has waited the maximum time.
# ANCHOR_BATCH_SIZE defaults to 1 with ReceiptBatchLog (each transfer anchored as it settles), 20 otherwise.
# ANCHOR_BATCH_SIZE=1
# ANCHOR_BATCH_MAX_WAIT_MINUTES=30
# ANCHOR_BATCH_MAX_LEAVES=256

# Receipt checker (apps/web). IntentRegistry holds the receipts anchored one by one before batching;
# its deploy block lets the checker find their anchoring transactions.
INTENT_REGISTRY_ADDRESS=
INTENT_REGISTRY_DEPLOY_BLOCK=
# RECEIPT_BATCH_LOG_ADDRESS and RECEIPT_BATCH_REGISTRY_ADDRESS (above) are read by the web app too:
# batches in either verify as long as both stay set.

# RelayMesh's fee (apps/web): each transfer also pays RELAYMESH_FEE tPOT to the account behind
# RELAYMESH_FEE_RECIPIENT, in the same signed call. Point it at the relayer so transfers fund the
# anchoring of their own receipts. Set both or neither.
# RELAYMESH_FEE=0.2
# RELAYMESH_FEE_RECIPIENT=0x...

# Optional watcher tuning (defaults shown)
# WATCHER_POLL_MS=6000
# WATCHER_SCAN_BACKFILL_BLOCKS=150
# WATCHER_MAX_BLOCKS_PER_PASS=100
# WATCHER_SIGNED_TX_LIFETIME_SECONDS=1800

# Contract deployment (contracts/scripts/deploy.ts). Never commit a real key.
DEPLOYER_PRIVATE_KEY=
# ReceiptBatchRegistry's recorder, fixed at deployment; defaults to the deployer's address.
BATCH_RECORDER_ADDRESS=
