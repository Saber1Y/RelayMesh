{
  "name": "@relaymesh/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "compile": "tsx scripts/compile.ts",
    "simulate-deploy": "tsx --env-file-if-exists=../.env scripts/simulate-deploy.ts",
    "deploy:registry": "tsx --env-file-if-exists=../.env scripts/deploy.ts",
    "simulate:batch-registry": "tsx --env-file-if-exists=../.env scripts/simulate-batch-registry.ts",
    "deploy:batch-registry": "tsx --env-file-if-exists=../.env scripts/deploy.ts ReceiptBatchRegistry",
    "simulate:batch-log": "tsx --env-file-if-exists=../.env scripts/simulate-batch-registry.ts ReceiptBatchLog",
    "deploy:batch-log": "tsx --env-file-if-exists=../.env scripts/deploy.ts ReceiptBatchLog"
  },
  "dependencies": {
    "@relaymesh/chains": "workspace:*",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "solc": "0.8.37"
  },
  "exports": {
    "./abi/IntentRegistry": "./abi/IntentRegistry.ts",
    "./abi/ReceiptBatchRegistry": "./abi/ReceiptBatchRegistry.ts",
    "./abi/ReceiptBatchLog": "./abi/ReceiptBatchLog.ts"
  }
}
